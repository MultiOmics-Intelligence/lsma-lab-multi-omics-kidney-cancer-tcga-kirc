{
  "workflow": "multi-omics",
  "workflow_version": "1.0.0",
  "lab_run_time": "5 min 41 s (importing and combining the three TCGA layers: about 4 min)",
  "robustness_run_time": "3 min 41 s (1,000 features per layer)",
  "lab_fix": "multi-omics input stage: remove_sex_chromosomes = true; DIABLO near.zero.var = TRUE (see README)",
  "parameters": {
    "input": {
      "max_features": 2000,
      "min_carriers": 5,
      "remove_sex_chromosomes": true
    },
    "exploration": {
      "color_by": "stage",
      "permutations": 499
    },
    "associations": {
      "n_top": 100,
      "alpha": 0.05
    },
    "factors": {
      "enabled": true,
      "n_factors": 8,
      "min_variance_explained": 1,
      "convergence": "fast",
      "n_factors_shown": 3
    },
    "clustering": {
      "enabled": true,
      "n_clusters": null,
      "compare_column": "stage",
      "time_column": "survival_days",
      "event_column": "vital_status",
      "event_value": "Dead",
      "neighbours": 20,
      "sigma": 0.5,
      "iterations": 20
    },
    "supervised": {
      "enabled": true,
      "group_column": "vital_status",
      "n_components": 2,
      "features_per_layer": 15,
      "link_between_layers": 0.1,
      "folds": 5,
      "repeats": 10,
      "permutations": 50
    },
    "comparison": {
      "enabled": true,
      "n_clusters": null,
      "compare_column": "vital_status",
      "include_rgcca": true
    }
  },
  "software_versions": {
    "input": {
      "R": "4.5.2",
      "data.table": "1.18.6.1",
      "jsonlite": "2.0.0",
      "Bioconductor": "3.21"
    },
    "exploration": {
      "R": "4.5.2",
      "jsonlite": "2.0.0",
      "Bioconductor": "3.21"
    },
    "associations": {
      "R": "4.5.2",
      "jsonlite": "2.0.0",
      "Bioconductor": "3.21"
    },
    "factors": {
      "R": "4.5.2",
      "MOFA2": "1.18.0",
      "reticulate": "1.47.0",
      "mofapy2": "0.7.5",
      "Bioconductor": "3.21"
    },
    "clustering": {
      "R": "4.5.2",
      "SNFtool": "2.3.1",
      "cluster": "2.1.8.1",
      "survival": "3.8.3",
      "Bioconductor": "3.21"
    },
    "supervised": {
      "R": "4.5.2",
      "mixOmics": "6.32.0",
      "Bioconductor": "3.21"
    },
    "comparison": {
      "R": "4.5.2",
      "SNFtool": "2.3.1",
      "mixOmics": "6.32.0",
      "cluster": "2.1.8.1",
      "jsonlite": "2.0.0",
      "Bioconductor": "3.21"
    }
  }
}